# 깨비지기 — 환경변수 템플릿
#
# 본 파일은 문서화 목적으로만 사용. 실제 값은 tene가 관리.
# 로컬 실행: `tene run -- pnpm dev` — tene가 process.env로 자동 주입.
#
# Vercel CI/CD에서는 dashboard의 Environment Variables를 사용 (docs/05-infra/environments.md §5).
# 환경별 매트릭스: docs/sprint/10-sprint-launch/design.md §8.1

# ─── Firebase Web SDK (클라이언트 공개 — 보안: Firestore/RTDB rules + App Check) ───
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ─── Firebase Realtime Database URL (Sprint 10 / Phase A — RTDB asia-southeast1) ───
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://god-kkabi-guide-default-rtdb.asia-southeast1.firebasedatabase.app

# ─── 사이트 URL (canonical + sitemap + OG + NextAuth) ───
# Production: https://kkaebizigi.com
# Preview:    https://staging.kkaebizigi.com
# Development: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://kkaebizigi.com

# ─── NextAuth v5 (Sprint 10 / Phase B — Google sign-in 단일) ───
# AUTH_URL: NextAuth canonical URL (production/preview/development 분리)
# AUTH_SECRET: openssl rand -base64 32 으로 생성, production/preview 분리
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET: GCP Console에서 OAuth 2.0 client 발급
AUTH_URL=https://kkaebizigi.com
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── (선택) Naver Search Console 검증 ───
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=

# ─── Firebase Admin SDK (서버 사이드, Server Action / Route Handler) ───
# base64 또는 raw JSON 둘 다 지원 (lib/firebase/admin.ts §parseServiceAccount)
FIREBASE_SERVICE_ACCOUNT_JSON=

# ─── (선택) Google AdSense ───
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# ─── (V2+) Toss 결제 ───
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ─── Cron 인증 (Vercel cron / 외부 트리거) ───
CRON_SECRET=

# ─── Sentry (Sprint 10 / Phase F-final Task #32) ───
# Sentry DSN — production / preview / development 분리 권장.
# 미설정 시 SDK init은 graceful skip (빌드/런타임 영향 없음).
# 출처: docs/sprint/10-sprint-launch/design.md §9.1
NEXT_PUBLIC_SENTRY_DSN=
# Sentry source map 업로드 (선택 — 미설정 시 업로드 silent skip)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# 환경 라벨 override (없으면 VERCEL_ENV → NODE_ENV fallback)
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# ─── (Sprint 11 / Images — AWS S3, post-launch) ───
# AWS_S3_BUCKET=kkaebizigi-images
# AWS_S3_REGION=ap-northeast-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# NEXT_PUBLIC_CLOUDFRONT_URL=
