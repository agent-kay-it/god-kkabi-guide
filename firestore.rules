rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ───────── helpers
    function isAuth() { return request.auth != null; }
    function isAdmin() { return isAuth() && request.auth.token.role == 'admin'; }
    function isBanned() { return isAuth() && request.auth.token.role == 'banned'; }
    function isRegisteredUnbanned() {
      return isAuth()
        && request.auth.token.registered == true
        && request.auth.token.role != 'banned';
    }
    function isOwner(uid) { return isAuth() && request.auth.uid == uid; }

    // ───────── users — 본인 + admin만
    match /users/{userId} {
      allow read: if isAdmin() || (isAuth() && request.auth.uid == userId);
      allow create: if isAuth()
        && request.auth.uid == userId
        && request.resource.data.role == 'user'
        && request.resource.data.banned == false
        && request.resource.data.consent.age14plus == true;
      allow update: if isAdmin();
      allow update: if isAuth()
        && request.auth.uid == userId
        && request.resource.data.gameUid == resource.data.gameUid
        && request.resource.data.role == resource.data.role
        && request.resource.data.banned == resource.data.banned;
      allow delete: if false;
    }

    // ───────── servers / munpas / chat_channels — 모두 read true
    match /servers/{serverId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /munpas/{munpaId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /chat_channels/{channelId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ───────── chat_reports — 본인 create / admin read+update / delete 금지
    match /chat_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuth()
        && !isBanned()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reporterUid != request.resource.data.reportedUid;
      allow update: if isAdmin();
      allow delete: if false;
    }
    match /chat_report_counts/{messageId} {
      allow read: if isAdmin();
      allow write: if false; // Server Action (Admin SDK)만 변경
    }

    // ───────── bookmarks/{userId}/items/{bookmarkId}
    match /bookmarks/{userId}/items/{bookmarkId} {
      allow read: if isAuth() && request.auth.uid == userId;
      allow write: if false; // Server Action (Admin SDK)만 변경
    }

    // ───────── wiki_* — public read / admin write
    match /wiki_classes/{id}        { allow read: if true; allow write: if isAdmin(); }
    match /wiki_jinryeong/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /wiki_skills/{id}         { allow read: if true; allow write: if isAdmin(); }
    match /wiki_equipment/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /wiki_contents/{id}       { allow read: if true; allow write: if isAdmin(); }

    // ───────── tips
    match /tips/{tipId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ───────── moderation_logs — admin만
    match /moderation_logs/{logId} {
      allow read: if isAdmin();
      allow create: if false; // Server Action만 작성 (Admin SDK 우회)
      allow update, delete: if false;
    }

    // ───────── Sprint V1 — posts + comments + reactions + penalties + dictionaries + reports

    // posts: 공개 read / registered create / owner|admin update,delete
    match /posts/{postId} {
      allow read: if true;
      allow create: if isRegisteredUnbanned()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.title.size() >= 4
        && request.resource.data.title.size() <= 60
        && request.resource.data.body.size() >= 30
        && request.resource.data.body.size() <= 5000;
      // update: 본인 (24h 정책은 Server Action에서 보조 검증) 또는 admin
      allow update: if isOwner(resource.data.authorUid) || isAdmin();
      allow delete: if isOwner(resource.data.authorUid) || isAdmin();

      // comments (depth 2 enforcement은 Server Action에서 처리)
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isRegisteredUnbanned()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.body.size() >= 1
          && request.resource.data.body.size() <= 500;
        allow update: if isOwner(resource.data.authorUid) || isAdmin();
        allow delete: if isOwner(resource.data.authorUid) || isAdmin();

        match /reactions/{uid} {
          allow read: if isAuth();
          allow create, delete: if isRegisteredUnbanned() && request.auth.uid == uid;
          allow update: if false;
        }
      }

      // post reactions
      match /reactions/{uid} {
        allow read: if isAuth();
        allow create, delete: if isRegisteredUnbanned() && request.auth.uid == uid;
        allow update: if false;
      }
    }

    // post_reports / comment_reports — 본인 create / admin read+update
    match /post_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isRegisteredUnbanned()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reporterUid != request.resource.data.reportedUid;
      allow update: if isAdmin();
      allow delete: if false;
    }
    match /comment_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isRegisteredUnbanned()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reporterUid != request.resource.data.reportedUid;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // penalties — admin read만 / Server Action (Admin SDK)에서 작성
    match /penalties/{penaltyId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // moderation_dictionaries — 모든 인증 사용자 read (클라이언트 마스킹) / admin write
    match /moderation_dictionaries/{dictId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Sprint V2 P3.A — post_edit_audits: admin read만 / Server Action에서만 write
    match /post_edit_audits/{auditId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Sprint V2 P3.B + P5 (CA2-I2) — simulator_runs: 누구나 write (익명 허용) / admin read.
    // 강화된 검증: types + value bounds + serverTimestamp + 필드 화이트리스트 + payload guard.
    // SSOT: lib/simulator/actions.ts recordSimulatorRun (admin SDK 통해 bypass).
    // 본 rule은 client SDK 직접 write 방어용 (rule이 표현하는 안전한 payload 모양).
    match /simulator_runs/{runId} {
      allow read: if isAdmin();
      allow create: if
        // 필드 화이트리스트: id + comboId + jinryeongIds + synergyScore + tier + timestamp (필수)
        // classId + uid (옵션)
        request.resource.data.keys().hasOnly(
          ['id', 'uid', 'comboId', 'jinryeongIds', 'classId', 'synergyScore', 'tier', 'timestamp']
        )
        && request.resource.data.keys().hasAll(
          ['id', 'comboId', 'jinryeongIds', 'synergyScore', 'tier', 'timestamp']
        )
        // id: doc id와 일치 (auto-id 일관성)
        && request.resource.data.id is string
        && request.resource.data.id == runId
        // jinryeongIds: 정확히 3개 + 중복 없음 + 1≤len≤32
        && request.resource.data.jinryeongIds is list
        && request.resource.data.jinryeongIds.size() == 3
        && request.resource.data.jinryeongIds[0] is string
        && request.resource.data.jinryeongIds[1] is string
        && request.resource.data.jinryeongIds[2] is string
        && request.resource.data.jinryeongIds[0].size() >= 1
        && request.resource.data.jinryeongIds[0].size() <= 32
        && request.resource.data.jinryeongIds[1].size() >= 1
        && request.resource.data.jinryeongIds[1].size() <= 32
        && request.resource.data.jinryeongIds[2].size() >= 1
        && request.resource.data.jinryeongIds[2].size() <= 32
        && request.resource.data.jinryeongIds.toSet().size() == 3
        // comboId: 32~128 문자 (sorted-join)
        && request.resource.data.comboId is string
        && request.resource.data.comboId.size() >= 3
        && request.resource.data.comboId.size() <= 128
        // synergyScore: 0~1000
        && request.resource.data.synergyScore is number
        && request.resource.data.synergyScore >= 0
        && request.resource.data.synergyScore <= 1000
        // tier: enum S/A/B/C/D
        && request.resource.data.tier is string
        && request.resource.data.tier in ['S', 'A', 'B', 'C', 'D']
        // classId 옵션 enum
        && (!('classId' in request.resource.data)
            || request.resource.data.classId in ['warrior', 'swordsman', 'medium'])
        // uid 옵션 — request.auth.uid와 일치 (서버 액션 외 client 위조 방어)
        && (!('uid' in request.resource.data)
            || (request.auth != null
                && request.resource.data.uid is string
                && request.resource.data.uid == request.auth.uid))
        // timestamp: server timestamp만 허용
        && request.resource.data.timestamp == request.time;
      allow update, delete: if false;
    }

    // Sprint V2 P3.B — jinryeong_stats: 모든 사용자 read / Server Action(cron)만 write
    match /jinryeong_stats/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Sprint V2 P3.C — pvp_stats: 동일 패턴
    match /pvp_stats/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Sprint V2 P3.E — subscriptions: 본인 read / Server Action만 write
    match /subscriptions/{subId} {
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /payment_history/{histId} {
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Sprint V2 P3.D — pain_topics + pain_mentions: admin only
    match /pain_topics/{topicId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /pain_mentions/{mentionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Sprint V3 P3.A (CA2-I11) — user_claims_retry_queue: admin read (모니터링) / Server Action만 write
    match /user_claims_retry_queue/{queueId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Sprint V3 P3.B (F4.2) — B2B API
    // api_clients: admin read / Server Action issue/revoke만 write
    match /api_clients/{clientId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /api_usage/{usageId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Sprint V3 P3.C (F4.3) — Admin SaaS whitelabel
    match /tenant_themes/{tenantId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Sprint V3 P3.D (F4.1) — 외부 신호 ETL
    match /external_signals/{signalId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Sprint 10 P-D (F2.2) — OG link preview cache: server-only (Admin SDK).
    // 7일 TTL, urlHash(SHA256 prefix 32 char) 기반.
    match /linkPreviewCache/{urlHash} {
      allow read, write: if false;
    }

    // Sprint 10 P-E (F3.x) — pinned chat messages: 모든 인증 사용자 read / Server Action만 write
    match /pinned_messages/{pinnedId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // Sprint V2 P3.C — coupons: 검증된 것만 공개 read / 등록 사용자 create (pending) / admin verify
    match /coupons/{couponId} {
      allow read: if resource.data.status == 'verified' || isAdmin();
      allow create: if isRegisteredUnbanned()
        && request.resource.data.status == 'pending'
        && request.resource.data.submittedBy == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;
      // votes subcollection
      match /votes/{uid} {
        allow read: if isAdmin();
        allow write: if isRegisteredUnbanned() && uid == request.auth.uid;
      }
    }

    // 기본 거부
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
