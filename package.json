{
  "name": "kkaebizigi",
  "version": "0.1.0",
  "private": true,
  "description": "갓깨비 키우기 비공식 팬 가이드 — Next.js 16 + Firebase + shadcn/ui",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "tene run -- next dev --turbopack -p 3000",
    "build": "tene run -- next build",
    "vercel-build": "next build",
    "start": "tene run -- next start -p 3000",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "audit:arch": "node scripts/audit-clean-arch.mjs",
    "audit:arch:report": "node scripts/audit-clean-arch.mjs --report",
    "audit:design": "node scripts/audit-design-system.mjs",
    "audit:design:report": "node scripts/audit-design-system.mjs --report",
    "audit:all": "pnpm audit:arch && pnpm audit:design",
    "lighthouse": "./scripts/lighthouse-ci.sh",
    "lighthouse:desktop": "./scripts/lighthouse-ci.sh --desktop",
    "lighthouse:mobile": "./scripts/lighthouse-ci.sh --mobile",
    "seed:upload-images": "node scripts/upload-seed-images.mjs",
    "seed:staging-posts": "tene run -- node scripts/seed-staging-posts.mjs",
    "perf:baseline": "node scripts/lighthouse-baseline.mjs",
    "perf:analyze": "ANALYZE=true tene run -- next build",
    "test:e2e": "./scripts/test-e2e.sh",
    "test:e2e:staging": "./scripts/test-e2e.sh --staging",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:setup": "./scripts/test-e2e.sh --setup",
    "test:e2e:report": "playwright show-report e2e/playwright-report"
  },
  "dependencies": {
    "@auth/firebase-adapter": "^2.11.2",
    "@aws-sdk/client-s3": "^3.1048.0",
    "@aws-sdk/s3-request-presigner": "^3.1048.0",
    "@hookform/resolvers": "^5.2.2",
    "@sentry/nextjs": "^10.53.1",
    "@types/hast": "^3.0.4",
    "@vercel/speed-insights": "^2.0.0",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.10.0",
    "framer-motion": "^12.12.1",
    "lucide-react": "^0.511.0",
    "next": "16.2.6",
    "next-auth": "5.0.0-beta.31",
    "next-intl": "^4.12.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.75.0",
    "recharts": "^3.8.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-rehype": "^11.1.2",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.3.0",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@next/bundle-analyzer": "^16.2.6",
    "@next/eslint-plugin-next": "^16.2.6",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "16.2.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.18.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^3.1.4",
    "wait-on": "^9.0.10"
  },
  "engines": {
    "node": ">=20.18.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
