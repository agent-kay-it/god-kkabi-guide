{
  "$schema": "https://github.com/GoogleChrome/lighthouse-ci/raw/main/types/lighthouserc.schema.json",
  "ci": {
    "collect": {
      "url": [
        "https://staging.kkaebizigi.com/",
        "https://staging.kkaebizigi.com/class",
        "https://staging.kkaebizigi.com/jinryeong",
        "https://staging.kkaebizigi.com/post"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "mobile",
        "throttlingMethod": "simulate",
        "skipAudits": ["uses-http2"],
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "preset": "lighthouse:no-pwa",
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.85 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["warn", { "minScore": 0.9 }],
        "first-contentful-paint": ["warn", { "maxNumericValue": 2000 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 3000 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 600 }],
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.1 }],
        "uses-rel-preconnect": "off",
        "uses-rel-preload": "off",
        "csp-xss": "off",
        "third-party-cookies": "off"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci-mobile",
      "reportFilenamePattern": "%%PATHNAME%%-%%DATETIME%%-mobile-report.%%EXTENSION%%"
    }
  }
}
