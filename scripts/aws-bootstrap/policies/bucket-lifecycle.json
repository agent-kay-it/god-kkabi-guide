{
  "Rules": [
    {
      "ID": "tmp-1day-expire",
      "Status": "Enabled",
      "Filter": { "Prefix": "tmp/" },
      "Expiration": { "Days": 1 }
    },
    {
      "ID": "chat-30day-IA-180day-Glacier",
      "Status": "Enabled",
      "Filter": { "Prefix": "chat/" },
      "Transitions": [
        { "Days": 30, "StorageClass": "STANDARD_IA" },
        { "Days": 180, "StorageClass": "GLACIER_IR" }
      ]
    },
    {
      "ID": "posts-30day-IA-365day-Glacier",
      "Status": "Enabled",
      "Filter": { "Prefix": "posts/" },
      "Transitions": [
        { "Days": 30, "StorageClass": "STANDARD_IA" },
        { "Days": 365, "StorageClass": "GLACIER_IR" }
      ]
    },
    {
      "ID": "delete-incomplete-multipart-uploads-7day",
      "Status": "Enabled",
      "Filter": {},
      "AbortIncompleteMultipartUpload": { "DaysAfterInitiation": 7 }
    }
  ]
}
